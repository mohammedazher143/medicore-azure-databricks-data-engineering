{
	"name": "pl_metadata_driven_ingestion",
	"properties": {
		"activities": [
			{
				"name": "lk_read_pipeline_metadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT SourceContainer, SourceFileName, TargetSchema, TargetTable FROM log.PipelineMetadataRegistry WHERE IsActive = 1;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_dynamic_sql_sink",
						"type": "DatasetReference",
						"parameters": {
							"p_target_schema": "log",
							"p_target_table": "PipelineMetadataRegistry"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "fe_loop_through_metadata",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "lk_read_pipeline_metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('lk_read_pipeline_metadata').output.value\n",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "copy_csv_to_staging",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_dynamic_csv_source",
									"type": "DatasetReference",
									"parameters": {
										"p_source_container": "@item().SourceContainer",
										"p_source_filename": "@item().SourceFileName"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_dynamic_sql_sink",
									"type": "DatasetReference",
									"parameters": {
										"p_target_schema": "@item().TargetSchema",
										"p_target_table": "@item().TargetTable"
									}
								}
							]
						}
					]
				}
			}
		],
		"annotations": []
	}
}