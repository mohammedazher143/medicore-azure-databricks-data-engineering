{
	"name": "pl_Hospital_Metadata_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "Lookup_IngestionMetadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "\nSELECT\n    MetadataID,\n    SourceName,\n    SourceFolder,\n    SourceFileName,\n    DestinationFolder,\n    LoadType,\n    WatermarkColumn,\n    WatermarkValue\nFROM dbo.IngestionMetadata\nWHERE IsActive = 1;\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_SQL_IngestionMetadata",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Metadata",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_IngestionMetadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "\n@activity('Lookup_IngestionMetadata').output.value\n",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy_Hospital_CSV",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_LandingCsv",
									"type": "DatasetReference",
									"parameters": {
										"pFolderPath": {
											"value": "@item().SourceFolder",
											"type": "Expression"
										},
										"pFileName": {
											"value": "@item().SourceFileName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"annotations": []
	}
}