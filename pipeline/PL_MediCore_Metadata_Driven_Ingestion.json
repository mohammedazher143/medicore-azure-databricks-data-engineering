{
	"name": "PL_MediCore_Metadata_Driven_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Active_Metadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n    metadata_id,\n    source_name,\n    source_type,\n    source_container,\n    source_folder,\n    source_file_pattern,\n    file_delimiter,\n    first_row_is_header,\n    text_qualifier,\n    source_encoding,\n    target_schema,\n    target_table,\n    load_type,\n    watermark_column\nFROM meta.ETL_Metadata\nWHERE is_active = 1\n  AND source_name = 'MediCore_Hospital_Raw';",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_metadata",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "fe_loop_through_metadata",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Active_Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('lk_read_pipeline_metadata').output.value\n",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "copy_csv_to_staging",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"disableMetricsCollection": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_dynamic_csv_source",
									"type": "DatasetReference",
									"parameters": {
										"p_source_container": "@item().SourceContainer",
										"p_source_filename": "@item().SourceFileName"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_dynamic_sql_sink",
									"type": "DatasetReference",
									"parameters": {
										"p_target_schema": "@item().TargetSchema",
										"p_target_table": "@item().TargetTable"
									}
								}
							]
						}
					]
				}
			}
		],
		"annotations": []
	}
}