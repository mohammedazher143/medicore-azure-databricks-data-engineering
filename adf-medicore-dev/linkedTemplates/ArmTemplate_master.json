{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-medicore-dev"
		},
		"LS_AzureSQL_MediCore_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_MediCore'"
		},
		"LS_ADLS_Gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stmedicoredev.dfs.core.windows.net/"
		},
		"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-medicore-dev-2026.vault.azure.net/"
		},
		"LS_AzureSQL_MediCore_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqldb-medicore-dev-server.database.windows.net"
		},
		"LS_AzureSQL_MediCore_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-medicore-dev"
		},
		"LS_AzureSQL_MediCore_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "mohammedazher"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-medicore-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureSQL_MediCore_password": {
						"value": "[parameters('LS_AzureSQL_MediCore_password')]"
					},
					"LS_ADLS_Gen2_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Gen2_properties_typeProperties_url')]"
					},
					"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureSQL_MediCore_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_MediCore_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_MediCore_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_MediCore_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_MediCore_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_MediCore_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}