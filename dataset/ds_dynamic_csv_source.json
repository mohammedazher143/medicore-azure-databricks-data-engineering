{
	"name": "ds_dynamic_csv_source",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_Gen2",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_source_container": {
				"type": "string"
			},
			"p_source_filename": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().p_source_filename",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().p_source_container",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": false,
			"quoteChar": "\""
		},
		"schema": []
	}
}